# Copy to .env and edit before running.

# Database — SQLite for local dev, Postgres for production
DATABASE_URL=sqlite:///./howmuddy.db
# DATABASE_URL=postgresql+asyncpg://muddy:muddy@localhost/howmuddy

# MQTT broker (Mosquitto)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_TOPIC=howmuddy/occupancy/#

# API
SECRET_KEY=change_me_in_production
API_PORT=8000

# Operating hours (24h, local time) — data outside these hours is flagged
OPEN_HOUR=11
CLOSE_HOUR=23
